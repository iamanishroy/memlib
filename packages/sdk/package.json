{
  "name": "@anishroy/memz",
  "version": "0.1.0",
  "description": "TypeScript SDK for the MemZ memory API",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "check-types": "tsc --noEmit",
    "dev": "tsup --watch"
  },
  "keywords": [
    "memz",
    "memory",
    "ai",
    "semantic",
    "embeddings",
    "sdk"
  ],
  "license": "MIT",
  "devDependencies": {
    "@memz/config": "*",
    "tsup": "^8.4.0",
    "typescript": "^5"
  }
}
